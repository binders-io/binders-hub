# The hub's settings, for docker compose: copy to /etc/binders/hub.env (or set BINDERS_ETC to the folder it's in).
# Every setting is described at the top of hub/src/main.ts.

# The address people open the hub at, with https. GitHub sends its webhooks and sign-ins here.
PUBLIC_URL=https://hub.example.com

# Seals what the hub keeps, GitHub's keys among them. Make one with: openssl rand -hex 32
# Keep a copy somewhere safe: without it the hub can't open what it sealed, and GitHub has to be set up again.
HUB_SECRET=

# GitHub logins who may change the hub's GitHub setup and options, besides whoever makes its GitHub App.
HUB_ADMINS=

# A machine the hub keeps for agents that have none: deploy/compose.yml's sandbox service (docker compose --profile
# sandbox up -d). The secret is both ends': make one with openssl rand -hex 32, the same in the hub and the sandbox.
# BINDERS_SANDBOX_URL=http://sandbox:4500
# BINDERS_SANDBOX_SECRET=
# Where its runners reach the hub: beside it, not through the public address, whose firewall (Cloudflare's, behind a
# tunnel) can take an agent's conversation for an attack and turn its steps away with a 403.
# BINDERS_SANDBOX_HUB_URL=http://hub:4400 (deploy/compose.yml sets this one itself)

# Who may sign in, besides the GitHub App's owner and its organization's members (comma-separated).
# HUB_ALLOWED_USERS=
# HUB_ALLOWED_ORGS=

# The first binder's address and name (main).
# HUB_SPACE=main
# HUB_NAME=Main

# Browsers enforce the content security policy (recommended once Settings shows nothing reported).
# CSP_ENFORCE=1
